{
  "expo": {
    "name": "New Balan Delivery",
    "slug": "delivery_partner_apk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/new_balan_logo.png",
    "scheme": "newbalandelivery",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#0056b3",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0056b3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.newbalan.medical.delivery"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/new_balan_logo.png",
        "backgroundColor": "#0056b3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.newbalan.medical.delivery",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "d47d9335-bad6-42c0-9172-e2933f0ba698"
      }
    }
  }
}
